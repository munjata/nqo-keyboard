// N'Ko (nqo) Keyboard Layout for Mandenkan / West Africa
// Supports modern XKB and GNOME on Wayland & X11
// Unicode block U+07C0–U+07FF

default partial alphanumeric_keys
xkb_symbols "nqo" {

    name[Group1] = "N'Ko (Mandenkan)";

    // Number Row (AE)
    key <TLDE> { [ U07D1, U07F3 ] }; // ߑ (Dagbasinna), ߳ (Double dot above)
    key <AE01> { [ U07C1, U07F9, 1 ] }; // ߁ (1), ߹ (Exclamation mark), 1
    key <AE02> { [ U07C2, at, 2 ] }; // ߂ (2), @, 2
    key <AE03> { [ U07C3, numbersign, 3 ] }; // ߃ (3), #, 3
    key <AE04> { [ U07C4, U07FE, 4 ] }; // ߄ (4), ߾ (Dorome sign), 4
    key <AE05> { [ U07C5, percent, 5 ] }; // ߅ (5), %, 5
    key <AE06> { [ U07C6, U07FF, 6 ] }; // ߆ (6), ߿ (Taman sign), 6
    key <AE07> { [ U07C7, ampersand, 7 ] }; // ߇ (7), &, 7
    key <AE08> { [ U07C8, asterisk, 8 ] }; // ߈ (8), *, 8
    key <AE09> { [ U07C9, parenleft, 9 ] }; // ߉ (9), (, 9
    key <AE10> { [ U07C0, parenright, 0 ] }; // ߀ (0), ), 0
    key <AE11> { [ U07FA, minus, U07FD ] }; // ߺ (Lajanyalan), -, ߽ (Dantayalan)
    key <AE12> { [ equal, plus, degree ] }; // =, +, °

    // Upper Row (AD - QWERTYUIOP[])
    key <AD01> { [ U07D1, U07F3 ] }; // ߑ (Dagbasinna), ߳ (Double dot above)
    key <AD02> { [ U07F4, U07F5 ] }; // ߴ (High tone apostrophe), ߵ (Low tone apostrophe)
    key <AD03> { [ U07CE ] }; // ߎ (Letter U)
    key <AD04> { [ U07CF ] }; // ߏ (Letter OO)
    key <AD05> { [ U07EC, U07F0 ] }; // ߬ (Short low tone), ߰ (Long low tone)
    key <AD06> { [ U07D5 ] }; // ߕ (Ta)
    key <AD07> { [ U07D3 ] }; // ߓ (Ba)
    key <AD08> { [ U07DB ] }; // ߛ (Sa)
    key <AD09> { [ U07E6, U07E7 ] }; // ߦ (Ya), ߧ (Nya Woloso)
    key <AD10> { [ U07D6, U07E8 ] }; // ߖ (Ja), ߨ (Jona Ja)
    key <AD11> { [ U07D4, bracketleft, braceleft ] }; // ߔ (Pa), [, {
    key <AD12> { [ U07FF, bracketright, braceright ] }; // ߿ (Taman sign), ], }

    // Home Row (AC - ASDFGHJKL;' \)
    key <AC01> { [ U07CB ] }; // ߋ (Letter EE)
    key <AC02> { [ U07CD ] }; // ߍ (Letter E)
    key <AC03> { [ U07CC ] }; // ߌ (Letter I)
    key <AC04> { [ U07CA ] }; // ߊ (Letter A)
    key <AC05> { [ U07D0, U07F6 ] }; // ߐ (Letter O), ߶ (Oo Dennen)
    key <AC06> { [ U07D8, U07FE ] }; // ߘ (Da), ߾ (Dorome sign)
    key <AC07> { [ U07DE ] }; // ߞ (Ka)
    key <AC08> { [ U07DF, U07E0 ] }; // ߟ (La), ߠ (Na Woloso)
    key <AC09> { [ U07E1, colon ] }; // ߡ (Ma), :
    key <AC10> { [ U07E3, quotedbl ] }; // ߣ (Na), "
    key <AC11> { [ U07E5, slash ] }; // ߥ (Wa), /
    key <BKSL> { [ U07D7, U07E9 ] }; // ߗ (Cha), ߩ (Jona Cha)

    // Bottom Row (AB - ZXCVBNM,./)
    key <AB01> { [ U07ED, U07F1 ] }; // ߭ (Short rising tone), ߱ (Long rising tone)
    key <AB02> { [ U07EF, colon ] }; // ߯ (Long high tone), :
    key <AB03> { [ U07F2, U07EE ] }; // ߲ (Nasalization mark), ߮ (Long descending tone)
    key <AB04> { [ U07EB, U07EF ] }; // ߫ (Short high tone), ߯ (Long high tone)
    key <AB05> { [ U07D2, U07F7 ] }; // ߒ (Letter N), ߷ (Gbakurunen)
    key <AB06> { [ U07DD ] }; // ߝ (Fa)
    key <AB07> { [ U07D9, U07DA, U07EA ] }; // ߙ (Ra), ߚ (Rra), ߪ (Jona Ra)
    key <AB08> { [ U07E2, U07F8 ] }; // ߢ (Nya), ߸ (N'Ko comma)
    key <AB09> { [ U07DC, period ] }; // ߜ (Gba), .
    key <AB10> { [ U07E4, U061F ] }; // ߤ (Ha), ؟ (Arabic question mark)

    include "level3(ralt_switch)"
};

// Aliases for standard XKB conventions and variants
partial alphanumeric_keys
xkb_symbols "basic" {
    include "nqo(nqo)"
};

partial alphanumeric_keys
xkb_symbols "bam" {
    include "nqo(nqo)"
};
